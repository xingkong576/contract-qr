":0,"enableLearn":true,"profession":null,"courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"GP10052","purchasePrice":"","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":false,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse1/image/202112/wu_1fo5altqn19sudlp1ioa471kklc.jpg","courseId":"a5b20c83fded44cb96c3e31ec409f8a0","learnPercent":"0","teacherName":"吴澄","classFee":"9.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse1/previewVideo/202112/wu_1fo5am66129p76k18511eo912bvf.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse1/image/202112/wu_1fo5altqn19sudlp1ioa471kklc.jpg","duration":"01:57:15","enableExam":"0","selectStatus":"2","rate":"0","scores":"3.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>世界经济数字化转型是大势所趋，新的工业革命将深刻重塑人类社会。习近平总书记指出，我们既要鼓励创新，促进数字经济和实体经济深度融合，也要关注新技术应用带来的风险挑战，加强制度和法律体系建设，重视教育和就业培训。我们既要立足自身发展，充分发掘创新潜力，也要敞开大门，鼓励新技术、新知识传播，让创新造福更多国家和人民。<%2Fp><p>本课程特邀中国工程院院士、清华大学自动化系教授吴澄，以企业数字化转型引入，明确数字化转型的国家目标和数字化转型的途径，并从三个方面详细阐述了我国要持续、深入推进智能制造。本课程旨在帮助学员了解企业数字化转型的必要性，领会国家建设制造强国的背景和途径，掌握智能制造的内涵和重大意义。<%2Fp><p>【培训收益】<%2Fp><ul class%3D\" list-paddingleft-2\" style%3D\"list-style-type: disc;\"><li><p>了解企业数字化转型的意义<%2Fp><%2Fli><li><p>知晓数字化转型的有效途径<%2Fp><%2Fli><li><p>掌握智能制造的内涵与重大意义<%2Fp><%2Fli><%2Ful><p>【授课专家】<%2Fp><p>吴澄，中国工程院院士，清华大学自动化系教授，博士生导师，国家CIMS工程技术研究中心主任，国家973项目“复杂生产制造过程实时智能控制与优化理论方法”首席科学家，国家863计划自动化领域首席科学家。<%2Fp><p>【课程大纲】<%2Fp><p>第一章&nbsp; 企业数字化转型<%2Fp><p>（一）数字化转型是大势所趋<%2Fp><p>（二）数字化生存<%2Fp><p>（三）数字化转型的定义<%2Fp><p>（四）数字经济<%2Fp><p>（五）数字化转型比较公认的说法<%2Fp><p>第二章&nbsp; 数字化转型的国家目标<%2Fp><p>（一）我国的现状<%2Fp><p>（二）国家发展的转型要从追求量的增长到质的发展<%2Fp><p>（三）颠覆性技术<%2Fp><p>第三章&nbsp; 数字化转型的途径<%2Fp><p>（一）衡量企业高质量发展的重要指标<%2Fp><p>（二）数字化转型的对策与背景<%2Fp><p>第四章&nbsp; 智能制造（一）<%2Fp><p>（一）智能制造成为热点的原因和背景<%2Fp><p>（二）智能制造的内涵<%2Fp><p>（三）持续、深入推进智能制造（上）<%2Fp><p>第五章&nbsp; 智能制造（二）<%2Fp><p>（四）持续、深入推进智能制造（下）<%2Fp><p>第六章&nbsp; 总结<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"企业数字化转型就是持续深入推进智能制造","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"科学技术","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"CL21096","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":false,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20253/wu_1ilfc57eee3b1vq9i21ggvoksb.jpg","courseId":"AUOO5lkPYyZgUfTNzdB1s","learnPercent":"0","teacherName":"专家讲师团","classFee":"21.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20253/wu_1ilfc5m4d4f21hla1nsl12okimdf.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20253/wu_1ilfc57eee3b1vq9i21ggvoksb.jpg","duration":"05:14:22","enableExam":"0","selectStatus":"2","rate":"0","scores":"7.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>随着AI技术的快速发展，AI办公已成为企业提升效率与创造力的关键手段。本课程将分享多个前沿的AI办公实用软件，涵盖数据分析、文档处理、图文创作等多个方面，通过实操演示，帮助学员快速掌握这些工具的应用技巧。通过本课程的学习，学员不仅能够紧跟AI技术的最新发展步伐，还能将这些高科技手段转化为生产力，实现工作流程的优化与创新，不仅提升个人技能，更为职业发展铺设坚实的基石。<%2Fp><p>【讲师介绍】<%2Fp><p>专家讲师团<%2Fp><p>【课程大纲】<%2Fp><p>第1节：AI搜索的技巧与应用&nbsp;&nbsp;&nbsp;&nbsp;<%2Fp><p>第2节：AI思维导图的轻松生成与应用 &nbsp; &nbsp;<%2Fp><p>第3节：AI文生图的创作与实践 &nbsp; &nbsp;<%2Fp><p>第4节：AI图生文的方法与应用 &nbsp; &nbsp;<%2Fp><p>第5节：AI智能体的搭建与应用 &nbsp; &nbsp;<%2Fp><p>第6节：利用AI实现办公材料的快速改写 &nbsp; &nbsp;<%2Fp><p>第7节：无所不能的AI语音聊天人 &nbsp; &nbsp;<%2Fp><p>第8节：AI调研数据分析的操作技巧 &nbsp; &nbsp;<%2Fp><p>第9节：利用AI进行论文评审 &nbsp; &nbsp;<%2Fp><p>第10节：免费提取图片文字和表格数据 &nbsp; &nbsp;<%2Fp><p>第11节：批量图片创意排版的神器<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"AI办公实用技能","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"工程技术","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01ZNRH25001","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20249/wu_1i7fcgar71qbe5j8ltcn487p0b.jpg","courseId":"B1h4oVhujarMckjFVzusA","learnPercent":"0","teacherName":"专家讲师团","classFee":"12.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20249/wu_1i7fdmkvh1sgm13e91b031hpf1g04f.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20249/wu_1i7fcgar71qbe5j8ltcn487p0b.jpg","duration":"02:55:08","enableExam":"0","selectStatus":"2","rate":"0","scores":"4.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>本课程全面概览数字化办公领域，详细介绍常用技术与工具及办公自动化系统（OA系统），同时，讲解职场办公必备技能和技能提升途径，以达到工作优化的目的。并探讨在政策驱动下，数字化办公的新理念与创新，助力学员把握未来办公趋势，实现高效智能办公。<%2Fp><p><br%2F><%2Fp><p>【讲师介绍】<%2Fp><p>专家讲师团<%2Fp><p><br%2F><%2Fp><p>【课程大纲】<%2Fp><p>第1节：数字化办公的常用技术与工具 &nbsp; &nbsp;<%2Fp><p>第2节：办公自动化系统（OA系统）简介 &nbsp; &nbsp;<%2Fp><p>第3节：职场办公常用技能概述（上） &nbsp; &nbsp;<%2Fp><p>第4节：职场办公常用技能概述（下） &nbsp; &nbsp;<%2Fp><p>第5节：数字化办公技能提升的有效途径 &nbsp; &nbsp;<%2Fp><p>第6节：政策驱动下的数字化办公及理念创新 &nbsp; &nbsp;<%2Fp><p><br%2F><%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"数字化办公基础——数字化办公概述","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"工程技术","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01ZNRH24022","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ii8vuo6r10menj31dr9kvfce2c.jpg","courseId":"RdbapCuf9D1dnQITmrAe8","learnPercent":"0","teacherName":"卢森煌","classFee":"6.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20251/wu_1ii8vv0n31bkr122816gr1h412jhf.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ii8vuo6r10menj31dr9kvfce2c.jpg","duration":"01:12:06","enableExam":"0","selectStatus":"2","rate":"0","scores":"2.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>本课程全面剖析ChatGPT的强大功能，解析其自然语言处理、自动化及智能分析等核心优势。深入探索ChatGPT如何重塑职场岗位需求，展示跨行业应用实例。还将推荐职场适用ChatGPT平台，并分享高效提问技巧。课程通过对比引导式与直接提问，深化问题定义与需求澄清，提升沟通效率。同时，传授角色扮演与高情商沟通策略，灵活应用ChatGPT优化工作流程。通过本课程的学习，学员将掌握关键技能，提升工作效率与质量，确保在快速变化的职场环境中保持卓越竞争力。&nbsp;&nbsp;&nbsp;&nbsp;<%2Fp><p>【讲师介绍】<%2Fp><p>卢森煌，互联网转型咨询公司“好个科技”创始人，前啊喔科技CEO，前阿里巴巴产品经理，AI畅销书作者，著有AI对话第一书《prompt魔法》。<%2Fp><p>【课程大纲】<%2Fp><p>第1节：ChatGPT的超能力&nbsp;&nbsp;&nbsp;&nbsp;<%2Fp><p>第2节：ChatGPT重塑岗位需求 &nbsp; &nbsp;<%2Fp><p>第3节：ChatGPT平台推荐与提问技巧 &nbsp; &nbsp;<%2Fp><p>第4节：如何进行问题定义和需求澄清 &nbsp; &nbsp;<%2Fp><p>第5节：引导式提问与直接提问的对比 &nbsp; &nbsp;<%2Fp><p>第6节：角色扮演与高情商沟通 &nbsp; &nbsp;<%2Fp><p>第7节：ChatGPT的强大功能<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"如何利用ChatGPT提高工作效率","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"工程技术","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01LZ25053","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ihma2fg91nu6j43nat14r429sb.jpg","courseId":"o1MiPsmqXMOX14VpavnmD","learnPercent":"0","teacherName":"张旭晓","classFee":"6.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20251/wu_1ihfa7cpgavn1smnp6952i1fv56.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ihma2fg91nu6j43nat14r429sb.jpg","duration":"01:28:40","enableExam":"0","selectStatus":"2","rate":"0","scores":"2.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>本课程深度融合WPS办公软件与AI技术，教授如何利用AI智能识别、排版编辑及自动生成文本等功能，实现文档编辑、格式调整、阅读理解等工作的快速处理。通过实操指导，学员将掌握AI辅助下的高效文档管理技巧，大幅提升工作效率。课程旨在帮助职场人士减轻文字工作负担，提升文档质量，确保信息传递的准确性和时效性。&nbsp;<%2Fp><p>【讲师介绍】<%2Fp><p>张旭晓，金山办公教育培训专家，金山知识服务金牌讲师。&nbsp; &nbsp;<%2Fp><p>【课程大纲】<%2Fp><p>第1节：智能创作：套用模板或输入主题，AI一键生成文稿！ &nbsp; &nbsp;<%2Fp><p>第2节：智能分析：阅读理解，报告等长文档重点一目了然！ &nbsp; &nbsp;<%2Fp><p>第3节：智能编排：WPS AI有妙招，轻松搞定文档排版难题！ &nbsp; &nbsp;<%2Fp><p>第4节：阅读理解：PDF文档不便读？召唤AI助手帮你搞定！ &nbsp; &nbsp;<%2Fp><p>第5节：排版编辑：版式文件不便改？PDF一站式帮你解决！ &nbsp; &nbsp;<%2Fp><p>第6节：内容创作：文案创作零思路？召唤WPS AI助手帮你写！ &nbsp; &nbsp;<%2Fp><p>第7节：美化编排：文档呈现太单调？3步让文档呈现更丰富！ &nbsp; &nbsp;<%2Fp><p>第8节：协同创作：文档共创效率低？在线协同编辑不存疑！&nbsp;&nbsp;<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"WPS AI助力职场文字办公更高效","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"个人综合素养","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01LZ25006","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ihma21s61o14smi11ak121k7qub.jpg","courseId":"FJ2mKK3f76dh3jXcCDdS6","learnPercent":"0","teacherName":"张伟崇","classFee":"6.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20251/wu_1ihf9vuk1jn61qoo1ghq1af2lra6.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ihma21s61o14smi11ak121k7qub.jpg","duration":"01:49:48","enableExam":"0","selectStatus":"2","rate":"0","scores":"2.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>本课程将WPS办公软件与AI技术结合，教授如何利用AI智能生成高质量PPT模板、自动优化排版布局、智能推荐配色与字体搭配等技巧。通过实操演练，学员将学会如何快速制作出视觉效果好、信息传达清晰的演示文稿。课程注重创意与实用并重，旨在帮助学员提升PPT制作效率，使演示内容更加吸引人，为职场汇报、演讲、提案等场合增添亮点。<%2Fp><p>【讲师介绍】<%2Fp><p>张伟崇，金山办公教育培训专家，金山办公技能认证大师，华智院AIGC技术与应用教育专家。&nbsp; &nbsp;&nbsp;<%2Fp><p>【课程大纲】<%2Fp><p>第1节：一键生成：输入主题或导入文档，AI一键生成PPT！ &nbsp; &nbsp;<%2Fp><p>第2节：文档转换：文档一键转换，快速套用公司PPT模板！ &nbsp; &nbsp;<%2Fp><p>第3节：智能排版：AI一键图示化，4招快速美化大段文本！ &nbsp; &nbsp;<%2Fp><p>第4节：图片处理：4大AI图片处理技巧，解决素材的难题！ &nbsp; &nbsp;<%2Fp><p>第5节：图片设计：只需一招，让你的图片展示形象又生动！ &nbsp; &nbsp;<%2Fp><p>第6节：多图排版：图片太多不会排版？3招帮你一键搞定！ &nbsp; &nbsp;<%2Fp><p>第7节：表格美化：用AI两步搞定表格排版，数据展示无忧！ &nbsp; &nbsp;<%2Fp><p>第8节：图表美化：用AI美化3类高频图表，信息一目了然！ &nbsp; &nbsp;<%2Fp><p>第9节：页面动画：AI一键添加动画，3招让演示生动有趣！&nbsp; &nbsp;&nbsp;<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"WPS AI助力打造引人瞩目的PPT","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"个人综合素养","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01LZ25005","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ihma1m3k7ch1r0u761iir1ngmb.jpg","courseId":"de5VoLjABjLj87ZpE7m0F","learnPercent":"0","teacherName":"张旭晓","classFee":"6.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20251/wu_1ihf9h34v7vu9vp5461tbsc1g6.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20251/wu_1ihma1m3k7ch1r0u761iir1ngmb.jpg","duration":"01:32:47","enableExam":"0","selectStatus":"2","rate":"0","scores":"2.00","testSet":"098001","courseDesc":"<p>【课程背景】<%2Fp><p>本课程将WPS办公软件与AI技术深度融合，教授如何利用WPS内置的智能工具进行数据清洗、整理、分析及可视化呈现。通过实战案例，学员将掌握AI辅助下的数据筛选、公式计算、图表制作等高效技能，实现从数据收集到报告生成的全程自动化处理。课程旨在帮助学员提升工作效率，精准洞察数据背后的价值，为决策提供有力支持。&nbsp; &nbsp;&nbsp;<%2Fp><p>【讲师介绍】<%2Fp><p>张旭晓，金山办公教育培训专家，金山知识服务金牌讲师。<%2Fp><p>张伟崇，金山办公教育培训专家，金山办公技能认证大师，华智院AIGC技术与应用教育专家。&nbsp; &nbsp;&nbsp;<%2Fp><p>【课程大纲】<%2Fp><p>第1节：创建收集：AI内容识别，数据收集表单一键生成！&nbsp; &nbsp;&nbsp;<%2Fp><p>第2节：统计分析：AI智能分析，让统计结果可视化呈现！ &nbsp; &nbsp;<%2Fp><p>第3节：数据整理：对话操作表格，不用担心功能找不到！ &nbsp; &nbsp;<%2Fp><p>第4节：函数公式：AI一键写公式，不懂函数公式也不怕！ &nbsp; &nbsp;<%2Fp><p>第5节：公式应用：AI在行政管理表与销售统计表的妙用！ &nbsp; &nbsp;<%2Fp><p>第6节：数据分析：AI一键做分析，轻松搞定数据可视化！ &nbsp; &nbsp;<%2Fp><p>第7节：批量处理：AI智能提取信息，快速生成洞察的内容！&nbsp;<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"WPS AI助力办公数据处理与分析","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"个人综合素养","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01LZ25004","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20255/wu_1iqk8ei7u129ud4m1a491m511mk2c.jpg","courseId":"HCvLXRL3LlMB5vMba2E2O","learnPercent":"0","teacherName":"马成功","classFee":"6.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20255/wu_1iqk8eknj150r1tab18uu18b41fkf.mp4","smalllogoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20255/wu_1iqk8ei7u129ud4m1a491m511mk2c.jpg","duration":"01:42:34","enableExam":"0","selectStatus":"2","rate":"0","scores":"2.00","testSet":"098001","courseDesc":"<p style%3D\"text-indent: 0em;\">【课程介绍】<%2Fp><p style%3D\"text-indent: 0em;\">本课程深入探讨AI时代对管理者的能力重构要求，聚焦如何通过数字化手段提升组织效能与员工赋能。课程从&quot;理性决策+情感赋能&quot;的双维领导力模型出发，解析京东、IDEO等企业激活团队潜能的创新实践，系统讲解&quot;五段经理人&quot;培养体系与组织知识管理方法论。通过小米、孩子王等典型案例，揭示数字化工具在构建&quot;组织大脑&quot;、沉淀企业智慧方面的应用价值，帮助管理者掌握AI时代引领团队持续进化的核心能力。&nbsp;&nbsp;&nbsp;&nbsp;<%2Fp><p style%3D\"text-indent: 0em;\">【讲师介绍】<br%2F>马成功，领英人力与组织专家，中国科学院心理研究所硕士，小米生态链谷仓创业学院总顾问，中国成人教育协会健康智慧教育专委会理事。<%2Fp><p style%3D\"text-indent: 0em;\">【课程大纲】<%2Fp><p style%3D\"text-indent: 0em;\">第1章：人才心力：AI时代需要什么样的领导者<%2Fp><p style%3D\"text-indent: 0em;\">第1节：AI时代对管理者的新要求：自身极度理性 激活绽放他人<%2Fp><p style%3D\"text-indent: 0em;\">第2节：如何激活组织中最容易躺平的两类员工？<%2Fp><p style%3D\"text-indent: 0em;\">第3节：五段经理人——释放员工潜能的五阶方法&nbsp;<%2Fp><p style%3D\"text-indent: 0em;\">第4节：京东：打开员工安全开关，疫情期间一战成名<%2Fp><p style%3D\"text-indent: 0em;\">第5节：硅谷智库IDEO：用数字化手段让一线团队无所不能<%2Fp><p style%3D\"text-indent: 0em;\">第2章：组织大脑：借助AI技术打造组织智慧大脑<%2Fp><p style%3D\"text-indent: 0em;\">第1节：AI时代的管理智慧：构建云端的组织大脑<%2Fp><p style%3D\"text-indent: 0em;\">第2节：AI如何帮组织萃取知识，帮员工提高工作效率？<%2Fp><p style%3D\"text-indent: 0em;\">第3节：从小米七字诀的正确排序，看企业如何萃取自己的方法论&nbsp;&nbsp;<%2Fp><p style%3D\"text-indent: 0em;\">第4节：伟大的公司靠什么持续成功？一套世界级方法论！<%2Fp><p style%3D\"text-indent: 0em;\">第5节：从母婴童行业的龙头企业孩子王，看搭建组织大脑的两大核心诉求&nbsp;&nbsp;&nbsp;&nbsp;<%2Fp>","introduction":"","ifDownloadMaterial":"0","courseName":"AI时代如何打造数字化人才","downLoadMaterial":null,"finishMustAfterLearnOpt":"否","showClassExpire":"否","showClassFee":"是","expire":"","trainplanName":null,"trainplanId":"af7e9b8dce964ebdab00c0647155de76","ifVirtual":false,"subject":"","suitYear":"","getClassHours":null,"userId":null,"learnCount":0,"ifForceMust":0,"enableLearn":true,"profession":"个人综合素养","courseClassType":"","ifLive":false,"livePeriod":null,"outCourse":false,"courseCode":"F01DY25008","purchasePrice":"0.0","addTime":"2026-03-23 12:36:31.0","courseDuration":null,"saleDesc":null,"effectiveDays":0,"selectCourseTime":"2026-05-28","labNames":null,"labIds":null,"orgId":null,"isPublishedToIndividual":null,"isPublishedToGroup":null,"subjectsDatadictId":null,"regionalDatadictId":null,"areaName":null,"pmphHour":null,"ifCoursePackage":null,"directorInfo":null,"ifAdditional":false,"otherPlanSelectedFlag":null,"inCard":false,"selected":false},{"changCourseFlag":"0","classType":"052002","logoUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/image/20258/wu_1j23ottvl1jjk1thg14osk6t1i12b.jpg","courseId":"XFxA50AZ9Um66jAJknCfi","learnPercent":"0","teacherName":"马成功","classFee":"6.00","previewUrl":"https://video.chinahrt.com/u/courseyun/gp5/upload/gpcourse3/previewVideo/20257/wu_1j0tg9bli1dt01rs21qth1hkl1vai6.